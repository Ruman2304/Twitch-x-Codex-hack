# Demo mode does not need secrets. Never commit real values to this file.
DEMO_MODE=true
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback
TWITCH_EVENTSUB_SECRET=
OPENAI_API_KEY=

# Blank DATABASE_URL uses volatile memory in demo mode only.
# PostgreSQL is required for live mode. Never commit a real database password.
DATABASE_URL=
DATABASE_WORKSPACE=default

# Required for Twitch sign-in. Fernet keys, newest first, comma-separated.
# Generate locally using the command in docs/TWITCH_SETUP.md; never commit keys.
TOKEN_ENCRYPTION_KEYS=

# Live mode connects to Twitch chat; demo mode always stays simulated.
TWITCH_EVENTSUB_ENABLED=true
